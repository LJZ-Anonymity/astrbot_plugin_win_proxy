{
  "auto_start": {
    "description": "加载插件时自动启动 Windows-MCP",
    "type": "bool",
    "default": true
  },
  "host": {
    "description": "Windows-MCP 服务监听地址",
    "type": "string",
    "default": "127.0.0.1"
  },
  "port": {
    "description": "Windows-MCP 服务监听端口",
    "type": "int",
    "default": 8000
  },
  "tool_tier": {
    "description": "工具权限档位",
    "type": "string",
    "default": "safe",
    "options": [
      "safe",
      "standard",
      "full"
    ],
    "labels": [
      "安全",
      "标准",
      "完全"
    ],
    "subtitles": [
      "仅只读与截图类工具",
      "增加鼠标键盘、窗口与常规应用操作",
      "含 PowerShell、文件系统、注册表、进程管理"
    ]
  },
  "extra_exclude_tools": {
    "description": "在当前权限档位基础上额外排除的工具（支持下拉多选）",
    "type": "list",
    "default": [],
    "options": [
      "PowerShell",
      "FileSystem",
      "Registry",
      "Process",
      "App",
      "Click",
      "Type",
      "Scroll",
      "Move",
      "Shortcut",
      "MultiSelect",
      "MultiEdit",
      "Clipboard",
      "Notification"
    ]
  },
  "admin_ids": {
    "description": "允许控制服务与调用桌面工具的管理员 ID 列表（留空表示不限制）",
    "type": "list",
    "items": {
      "type": "string"
    },
    "default": []
  },
  "uvx_path": {
    "description": "uvx.exe 路径（留空则自动从系统 PATH 查找 uvx）",
    "type": "string",
    "default": ""
  }
}